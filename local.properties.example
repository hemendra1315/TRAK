# Copy to local.properties and fill in from your Supabase project's API settings.
# Use the PUBLISHABLE (client) key only. Never paste a service-role or secret key here.
sdk.dir=/path/to/Android/Sdk
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
